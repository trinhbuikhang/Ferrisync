{
  "name": "ferrisync-native",
  "version": "0.1.0",
  "description": "N-API bindings for Ferrisync",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "ferrisync-native",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "scripts": {
    "smoke": "node scripts/smoke.cjs",
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ]
}
